{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 权限清单（对齐 Android MobileMap27 AndroidManifest）：
    //  网络（底图瓦片 / 升级检查）为 system_grant，随清单生效；
    //  定位（含粗略 + 精确两级）与拍照为 user_grant，运行时经 PermissionUtil 申请。
    //  鸿蒙无“所有文件访问”概念，外部数据统一经 @kit.CoreFileKit 选择器导入到沙箱，故不申请存储权限。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:perm_net_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:perm_net_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        // 长时任务（后台定位保活，continuousTaskManager location 型）：system_grant 普通级权限，随清单生效
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:perm_location_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:perm_camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // 跟随设备自动旋转（对齐 Android 端：MobileMap27 的 manifest 未做任何方向锁定）
        "orientation": "auto_rotation",
        "removeMissionAfterTerminate": true,
        // 长时任务类型：轨迹记录期后台定位保活（continuousTaskManager.startBackgroundRunning 的 ['location']）
        "backgroundModes": [
          "location"
        ],
        "exported": true,
        // 单实例（对齐 Android MainActivity 的 singleTask）：外部打开复用运行中的地图，
        // 不再起第二个 NativeMapView 实例；重复拉起经 onNewWant 承接文件 URI
        "launchType": "singleton",
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          // 外部打开（文件管理「打开方式」候选按安装时解析的本声明匹配，改后必须卸载重装）：
          // 匹配口径是 UTD/MIME，不是后缀——Android 侧的 pathPattern 在鸿蒙 file scheme 下无对应物。
          // kmz 的新预置 UTD general.kmz 需 OpenHarmony 6.1+，故先用 MIME 兜底（对齐 Android manifest）。
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.zip-archive",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/zip",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/vnd.google-earth.kmz",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}